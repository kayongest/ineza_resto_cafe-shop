<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ineza_resto_cafe-shop/

    # 1. Redirect direct .html requests to clean URLs without .html extension
    RewriteCond %{THE_REQUEST} \s/+(?:ineza_resto_cafe-shop/)?([^\s?]+)\.html[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 2. Rewrite clean URLs internally to the corresponding .html file if it exists
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^\s/]+)/?$ $1.html [L,QSA]
</IfModule>
